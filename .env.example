# ============================================
# Q-CMS RAG Server - 환경변수 설정
# 이 파일을 복사하여 .env 로 사용
#   cp .env.example .env
# ============================================

# --- PostgreSQL ---
POSTGRES_DB=rag
POSTGRES_USER=dev
POSTGRES_PASSWORD=changeme
PG_PORT=5433                    # 호스트 PG(5432)와 충돌 방지

# --- RAG Server ---
RAG_PORT=3200

# --- 임베딩 모델 ---
MODEL_NAME=intfloat/multilingual-e5-small

# --- 프로젝트 설정 ---
PROJECT_ID=qcms
PROJECT_NAME=Q-CMS

# --- LLM (vLLM / OpenAI-compatible) ---
VLLM_BASE_URL=http://host.docker.internal:7100/v1
VLLM_MODEL=google/gemma-4-E4B-it
